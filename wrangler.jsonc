{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-app",
  "compatibility_date": "2026-09-01",
  // Static Vite build served by Cloudflare; unknown paths fall back to index.html
  // so client-side routes like /login work on refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
